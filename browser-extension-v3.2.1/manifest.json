{
  "manifest_version": 3,
  "name": "NextKinHR Autofill & Recruiting Copilot v3.2.1",
  "version": "3.2.1",
  "description": "Universal AI application autofill, live ATS capture, and role-tailored resume generation across all websites. Nextkinlife LLC.",
  "author": "Nextkinlife LLC",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "activeTab",
    "cookies",
    "downloads",
    "scripting",
    "declarativeNetRequest",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NextKinHR Autofill & Recruiting Copilot v3.2.1"
  },
  "content_scripts": [
    {
      "matches": [
        "*://nextkinhr.com/*",
        "*://*.nextkinhr.com/*",
        "*://*.jobright-internal.com/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ],
      "js": [
        "agent-submission-sync.7f769d2a.js"
      ],
      "all_frames": false,
      "run_at": "document_start",
      "css": []
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "ats-submission-resume.81fcb254.js"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "css": []
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "applied-success-popup.beee901a.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "css": []
    },
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "field-discovery.d71b3ac3.js"
      ],
      "all_frames": false,
      "run_at": "document_idle",
      "css": []
    },
    {
      "matches": [
        "https://*.clearcompany.com/careers/jobs/*"
      ],
      "js": [
        "clearcompany-submission-attribution.d13048d5.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "css": []
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "contents.d42e7fcf.js"
      ],
      "all_frames": true,
      "exclude_matches": [
        "*://*.cloudflare.com/*",
        "https://li.protechts.net/*",
        "https://cs.ns1p.net/*",
        "https://merchantpool1.linkedin.com/*",
        "https://www.googletagmanager.com/*",
        "https://*.fls.doubleclick.net/activityi*",
        "https://li.protechts.net/*",
        "https://lnkd.demdex.net/*",
        "https://www.google.com/recaptcha/enterprise/*",
        "https://crcldu.com/*"
      ],
      "run_at": "document_start",
      "css": []
    },
    {
      "matches": [
        "https://nextkinhr.com/jobs/info/*",
        "https://preprod.nextkinhr.com/jobs/info/*",
        "https://beta.jobright-internal.com/jobs/info/*",
        "https://dev.jobright-internal.com/jobs/info/*"
      ],
      "js": [
        "scroll-to-anchor.45fefb1b.js"
      ],
      "all_frames": false,
      "run_at": "document_idle",
      "css": []
    },
    {
      "matches": [
        "https://nextkinhr.com/*",
        "https://preprod.nextkinhr.com/*",
        "https://beta.jobright-internal.com/*"
      ],
      "js": [
        "workday-password-sync.26980834.js"
      ],
      "all_frames": false,
      "run_at": "document_idle",
      "css": []
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "adapters/generic.js",
        "form-discovery.js",
        "field-mapping.js",
        "field-writer.js",
        "fill-session.js",
        "job-context.js",
        "candidate-context.js",
        "resume-engine.js",
        "outside-job-engine.js"
      ],
      "all_frames": false,
      "run_at": "document_idle",
      "css": []
    },
    {
      "matches": [
        "*://job-boards.greenhouse.io/*",
        "*://*.greenhouse.io/*"
      ],
      "js": [
        "adapters/generic.js",
        "form-discovery.js",
        "field-mapping.js",
        "field-writer.js",
        "embedded-support.js",
        "frame-agent.js"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "css": []
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "scraping-rules.json",
        "vendor/pdf.min.mjs",
        "vendor/pdf.worker.min.mjs",
        "resume-engine.js",
        "candidate-context.js",
        "job-context.js",
        "embedded-support.js",
        "stripe-job.js",
        "field-mapping.js",
        "field-writer.js",
        "form-discovery.js",
        "fill-session.js",
        "frame-agent.js",
        "outside-job-engine.js",
        "resume-workflows.js"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "helper-app.41ea2652.js",
        "global.f36301ce.css",
        "inter.42ee87cb.css"
      ]
    }
  ]
}