{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "NextKinHR Recruiting Copilot",
  "short_name": "NextKinHR",
  "version": "3.4.3",
  "description": "Sync your NextKinHR resume, capture job details, and fill application forms.",
  "icons": {
    "16": "icon16.plasmo.6c567d50.png",
    "32": "icon32.plasmo.76b92899.png",
    "48": "icon48.plasmo.aced7582.png",
    "128": "icon128.plasmo.3c1ed2d2.png"
  },
  "action": { "default_title": "Open Recruiting Copilot" },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "storage", "tabs", "scripting", "alarms"],
  "host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "exclude_matches": [
        "https://challenges.cloudflare.com/*",
        "https://*.recaptcha.net/*",
        "https://www.google.com/recaptcha/*",
        "https://*.hcaptcha.com/*",
        "https://accounts.google.com/*",
        "https://login.microsoftonline.com/*",
        "https://*.okta.com/*",
        "https://*.auth0.com/*",
        "https://*.duosecurity.com/*",
        "https://www.googletagmanager.com/*",
        "https://www.google-analytics.com/*",
        "https://*.stripe.com/*"
      ],
      "js": [
        "core/site-registry.js",
        "core/site-rules.js",
        "core/runtime-gate.js",
        "application-launch.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.nextkinhr.com/*",
        "https://*.jobright-internal.com/*",
        "https://*.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["portal-connection.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "exclude_matches": [
        "https://*.nextkinhr.com/*",
        "https://*.jobright-internal.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "*://*.google.com/*",
        "*://*.youtube.com/*",
        "*://*.facebook.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.instagram.com/*",
        "*://*.reddit.com/*",
        "*://*.wikipedia.org/*",
        "*://*.github.com/*",
        "*://*.cloudflare.com/*",
        "https://*.recaptcha.net/*",
        "https://*.hcaptcha.com/*",
        "https://accounts.google.com/*",
        "https://login.microsoftonline.com/*",
        "https://*.okta.com/*",
        "https://*.auth0.com/*",
        "https://*.duosecurity.com/*",
        "https://www.googletagmanager.com/*",
        "https://www.google-analytics.com/*",
        "https://*.stripe.com/*"
      ],
      "js": [
        "core/site-registry.js",
        "core/site-rules.js",
        "adapters/ats-adapters.js",
        "core/job-capture.js",
        "core/answer-bank.js",
        "core/question-intent.js",
        "core/field-mapping.js",
        "core/field-writer.js",
        "core/form-discovery.js",
        "core/application.js",
        "floating-widget.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
