{
  "manifest_version": 3,
  "name": "Recruiting Copilot — Nextkinlife LLC",
  "version": "3.0.0",
  "description": "Universal AI application autofill, live ATS capture, and role-tailored resume generation across all websites. Owned by Nextkinlife LLC.",
  "author": "Nextkinlife LLC",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "activeTab",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Recruiting Copilot — Nextkinlife LLC"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "resume-engine.js",
        "resume-import.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "scraping-rules.json",
        "vendor/pdf.min.mjs",
        "vendor/pdf.worker.min.mjs"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
