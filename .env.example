AI_PROVIDER=
AI_PROVIDER_ENCRYPTION_KEY=
# Optional Typesafe Jev key for server-mode combobox choices.
TYPESAFE_API_KEY=
DEFAULT_CANDIDATE_ID=
EMAIL_SYNC_SECRET=
EMAIL_TOKEN_ENCRYPTION_KEY=
# Optional JSON policy for Chrome extension automation, such as {"schemaVersion":1,"sites":{"workday":{"mode":"off"}}}.
EXTENSION_SITE_RULES=
# Optional comma-separated HTTPS callback URLs for additional extension builds (e.g. the store ID).
# The pinned unpacked Chrome and Firefox callbacks are already allowed.
EXTENSION_REDIRECT_ALLOWLIST=
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
# Standard provider credentials can determine the endpoint from the key.
# Keep custom gateway credentials, URL, and model in the same configuration group.
AI_PROVIDER_DEFAULT_API_KEY=
AI_PROVIDER_DEFAULT_BASE_URL=
AI_PROVIDER_DEFAULT_MODEL=
AI_GATEWAY_API_KEY=
SERVER_ENABLE_VERCEL_AI_SDK=true
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_RESPONSE_FORMAT=
SUPABASE_SERVICE_ROLE_KEY=
WEBHOOK_SECRET=
