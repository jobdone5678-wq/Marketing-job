# Existing Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Email capture server configuration. Never prefix these secrets with NEXT_PUBLIC.
APP_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
# Generate a base64-encoded 32-byte key and keep it stable while stored tokens exist.
EMAIL_TOKEN_ENCRYPTION_KEY=
# Separate random secret, at least 32 characters, shared by the app and worker.
EMAIL_SYNC_SECRET=

# Recruiting AI Configuration
# AI_PROVIDER options: 'openai' | 'gemini' (defaults to 'openai' if OPENAI_API_KEY is present)
AI_PROVIDER=openai

# OpenAI (Server-only; select a Responses file/structured-output capable model)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Google Gemini (Server-only; fast structured extraction and matching)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Firecrawl is deferred; no scraper key is required.
